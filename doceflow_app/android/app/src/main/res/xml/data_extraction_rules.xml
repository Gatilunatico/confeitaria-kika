<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nada do app vai para backup na nuvem NEM para transferência entre aparelhos.
     A sessão fica no Keystore deste aparelho e os dados vêm do Supabase (login de novo no celular novo). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
