<?xml version="1.0" encoding="utf-8"?>
<!-- Só HTTPS: o app nunca fala com servidor sem criptografia (Supabase, API e serviço são https). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
