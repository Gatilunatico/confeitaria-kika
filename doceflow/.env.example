# Copie este arquivo para .env e preencha os valores.
# NUNCA faça commit do arquivo .env.

APP_NAME=DoceFlow
# Nome da confeitaria exibido na vitrine
STORE_NAME=Kika Cakes
# Identificador da confeitaria no banco (coluna confeitarias.slug)
STORE_SLUG=kika-cakes

# Banco de dados: "sqlite" (somente testes locais) ou "supabase" (uso real)
DB_BACKEND=sqlite
SQLITE_PATH=data/doceflow_dev.db

# Supabase: Project Settings > API
# Use a chave "anon"/"publishable" com Row Level Security (RLS) ativa.
# NUNCA use a chave service_role neste app.
SUPABASE_URL=
SUPABASE_KEY=

# Número de WhatsApp da confeitaria, só dígitos, com DDI e DDD (ex.: 5511999999999)
WHATSAPP_NUMBER=

# Senha temporária do painel admin (provisória até a autenticação real)
ADMIN_PASSWORD=
