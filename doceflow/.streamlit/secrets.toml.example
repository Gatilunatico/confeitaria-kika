# Modelo dos "Secrets" do Streamlit Community Cloud (App → Settings → Secrets).
# Copie, preencha no painel do Streamlit e NUNCA versione o arquivo preenchido.
# Localmente, o equivalente é o arquivo .env (veja .env.example).

APP_NAME = "DoceFlow"
STORE_NAME = "Kika Cakes"
STORE_SLUG = "kika-cakes"
DB_BACKEND = "supabase"

# Supabase → Project Settings → API
SUPABASE_URL = "https://<id-do-projeto>.supabase.co"
# Somente a chave PUBLISHABLE (sb_publishable_...) ou anon. NUNCA a service_role / sb_secret.
SUPABASE_KEY = "sb_publishable_..."

# Com DB_BACKEND = "supabase" o WhatsApp da confeitaria vem do BANCO (confeitarias.whatsapp),
# não daqui. WHATSAPP_NUMBER só é usado no modo SQLite local; deixe sem configurar no Cloud.

# NÃO configure em produção: SUPABASE_DB_URL (só para migrações locais) e ADMIN_PASSWORD (só SQLite).
